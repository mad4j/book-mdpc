void setup() {
  size(480,640);
  noLoop();
}

void draw() {
  background(PAPER);
  float hw=0,y0=1e9,y1=-1e9;
  for(int i=0;i<HP.length;i+=2){hw=max(hw,abs(HP[i]-AXIS));y0=min(y0,HP[i+1]);y1=max(y1,HP[i+1]);}
  float s=min(width/(2*hw),height/(y1-y0))*.9;
  translate(width/2-AXIS*s,height/2-(y0+y1)/2*s);
  scale(s);
  fill(INK);noStroke();
  beginShape();
  for(int i=0;i<HP.length;i+=2)vertex(HP[i],HP[i+1]);
  for(int i=HP.length-2;i>=0;i-=2)vertex(2*AXIS-HP[i],HP[i+1]);
  endShape(CLOSE);
  save("spectre.png");
}
